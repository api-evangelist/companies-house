{
  "opencollection": "1.0.0",
  "info": {
    "name": "Companies House Public Data charges insolvency API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "insolvency",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /company/{company_number}/insolvency",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.company-information.service.gov.uk/company/:company_number/insolvency",
            "params": [
              {
                "name": "company_number",
                "value": "",
                "type": "path",
                "description": "The company number of the basic information to return."
              }
            ]
          },
          "docs": "Company insolvency information"
        }
      ]
    }
  ],
  "bundled": true
}