    {
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "http://127.0.0.1:10000/api.ch.gov.uk-specifications/swagger-2.0/spec/search-companies.json#/definitions/alphabeticalCompany"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "search#alphabetical-search",
            "search#enhanced-search"
          ]
        },
        "top_hit": {
          "allOf": [
            {
              "$ref": "http://127.0.0.1:10000/api.ch.gov.uk-specifications/swagger-2.0/spec/search-companies.json#/definitions/alphabetical_top_hit"
            },
            {
              "description": "The best matching company in alphabetical search results"
            }
          ]
        }
      }
    }
  ]
